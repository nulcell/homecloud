{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  dependencyDashboardApproval: false,
  timezone: 'Europe/Amsterdam',
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  prCreation: 'immediate',
  labels: [
    'renovate',
  ],
  semanticCommits: 'enabled',
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      semanticCommitType: 'feat',
    },
    {
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      semanticCommitType: 'fix',
    },
    {
      matchFileNames: [
        'gitops/**',
      ],
      groupName: 'dependencies',
      additionalBranchPrefix: '{{parentDir}}-',
      semanticCommitScope: '{{parentDir}}',
    },
    {
      matchFileNames: [
        'cluster/bootstrap/**',
      ],
      groupName: 'bootstrap',
      semanticCommitScope: 'bootstrap',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      semanticCommitScope: 'ci',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<10',
    },
    {
      matchManagers: [
        'mise',
      ],
      matchFileNames: [
        '.mise.toml',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'app-template',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'helm-values',
        'custom.regex',
      ],
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: false,
    },
  ],
  platformAutomerge: false,
  customManagers: [
    {
      customType: 'regex',
      description: 'Docker image tags in app-level values.yaml overrides that lack an adjacent repository:',
      managerFilePatterns: [
        '/^gitops\\/apps\\/.+\\/values(-.+)?\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>[a-z-]+))?[\\s\\S]*?tag:\\s*["\']?(?<currentValue>[\\w][\\w.-]*)["\']?',
      ],
    },
    {
      customType: 'regex',
      description: 'GitHub release download URLs',
      managerFilePatterns: [
        '/^gitops\\/.+\\/kustomization\\.yaml$/',
        '/^cluster\\/bootstrap\\/helmfile\\.yaml$/',
      ],
      matchStrings: [
        '\\n\\s*-\\s*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>v[\\w.-]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
}
