# All-in-one inventory for homecloud single-node OpenStack.
# Every group points at localhost — kolla-ansible takes care of the rest.

[all:vars]
ansible_connection=local
ansible_python_interpreter=/usr/bin/python3

[control]
localhost ansible_become=true

[network]
localhost ansible_become=true

[compute]
localhost ansible_become=true

[monitoring]
localhost ansible_become=true

[storage]
localhost ansible_become=true

[deployment]
localhost ansible_become=true

# ---------------------------------------------------------------------------
# Logical service groups — all map to the single host.
# ---------------------------------------------------------------------------
[baremetal:children]
control
network
compute
storage
monitoring

[common:children]
control
network
compute
storage
monitoring

