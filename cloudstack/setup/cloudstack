#!/bin/bash

# CloudStack CLI v1.0.0 - Single-file management tool for CloudStack
# Setup, manage, and operate CloudStack on Ubuntu 24.04 LTS
#
# Usage: cloudstack <component> <action> [options]
# Run with --help for documentation
#
# Architecture (v1):
#   - Single file (~1500 lines) for easy distribution
#   - 6 modules: common, database, storage, management, worker, cli
#   - State tracking: /var/lib/cloudstack/setup.state (JSON)
#   - Config: /etc/cloudstack/cli.conf (key=value)
#   - Logs: /var/log/cloudstack/setup.log
#
# Requirements:
#   - Ubuntu 24.04 LTS
#   - Two bridges: cloudbr0, cloudbr1 (on all KVM hosts)
#   - Root access

set -e

# Version
readonly VERSION="1.0.0"

# =============================================================================
# COMMON LIBRARY - Shared utility functions
# =============================================================================

# Color codes for output (check if not already defined)
if [[ -z "${COLOR_RED+x}" ]]; then
    readonly COLOR_RED='\033[0;31m'
    readonly COLOR_GREEN='\033[0;32m'
    readonly COLOR_YELLOW='\033[1;33m'
    readonly COLOR_BLUE='\033[0;34m'
    readonly COLOR_RESET='\033[0m'
fi

# Paths (check if not already defined)
if [[ -z "${STATE_DIR+x}" ]]; then
    readonly STATE_DIR="/var/lib/cloudstack"
    readonly STATE_FILE="${STATE_DIR}/setup.state"
    readonly CONFIG_DIR="/etc/cloudstack"
    readonly CONFIG_FILE="${CONFIG_DIR}/cli.conf"
    readonly LOG_DIR="/var/log/cloudstack"
    readonly LOG_FILE="${LOG_DIR}/setup.log"
fi

# Log levels (check if not already defined)
if [[ -z "${LOG_LEVEL_DEBUG+x}" ]]; then
    readonly LOG_LEVEL_DEBUG=0
    readonly LOG_LEVEL_INFO=1
    readonly LOG_LEVEL_WARN=2
    readonly LOG_LEVEL_ERROR=3
fi

# Current log level (default: INFO)
LOG_LEVEL=${LOG_LEVEL:-$LOG_LEVEL_INFO}

# SSH key HTTP server port
readonly SSH_KEY_SERVER_PORT=8000
readonly SSH_KEY_DIR="/var/lib/cloudstack/management/.ssh"

# Logging functions
log_debug() {
    [[ $LOG_LEVEL -le $LOG_LEVEL_DEBUG ]] && _log "DEBUG" "$COLOR_BLUE" "$@"
}

log_info() {
    [[ $LOG_LEVEL -le $LOG_LEVEL_INFO ]] && _log "INFO" "$COLOR_GREEN" "$@"
}

log_warn() {
    [[ $LOG_LEVEL -le $LOG_LEVEL_WARN ]] && _log "WARN" "$COLOR_YELLOW" "$@"
}

log_error() {
    [[ $LOG_LEVEL -le $LOG_LEVEL_ERROR ]] && _log "ERROR" "$COLOR_RED" "$@"
}

_log() {
    local level=$1
    local color=$2
    shift 2
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    echo -e "${color}[${level}]${COLOR_RESET} ${message}"
    
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    echo "[${timestamp}] [${level}] ${message}" >> "$LOG_FILE" 2>/dev/null || true
}

die() {
    log_error "$@"
    exit 1
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        die "This script must be run as root. Please use sudo."
    fi
}

validate_ip() {
    local ip=$1
    [[ $ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]
}

validate_bridge_exists() {
    local bridge=$1
    if ip link show "$bridge" &>/dev/null; then
        return 0
    else
        log_error "Bridge interface '$bridge' does not exist"
        return 1
    fi
}

validate_package_installed() {
    local package=$1
    dpkg -l | grep -q "^ii.*$package"
}

validate_service_running() {
    local service=$1
    systemctl is-active --quiet "$service"
}

check_prerequisites() {
    log_info "Running pre-flight checks..."
    
    if ! grep -q "Ubuntu 24.04" /etc/os-release 2>/dev/null; then
        log_warn "This script is designed for Ubuntu 24.04 LTS"
    fi
    
    local free_space=$(df / | tail -1 | awk '{print $4}')
    if [[ $free_space -lt 20971520 ]]; then
        log_warn "Low disk space: less than 20GB free on root partition"
    fi
    
    local total_mem=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    if [[ $total_mem -lt 4194304 ]]; then
        log_warn "Low memory: less than 4GB RAM available"
    fi
    
    log_info "Pre-flight checks completed"
}

init_state() {
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    if [[ ! -f "$STATE_FILE" ]]; then
        echo '{}' > "$STATE_FILE" 2>/dev/null || true
    fi
}

mark_complete() {
    local module=$1
    local operation=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    init_state
    
    if command -v jq &>/dev/null; then
        local temp_file=$(mktemp)
        jq --arg mod "$module" --arg op "$operation" --arg ts "$timestamp" \
           '.[$mod + "." + $op] = {"completed": true, "timestamp": $ts}' \
           "$STATE_FILE" > "$temp_file" 2>/dev/null || true
        mv "$temp_file" "$STATE_FILE" 2>/dev/null || true
    else
        echo "${module}.${operation}=${timestamp}" >> "$STATE_FILE" 2>/dev/null || true
    fi
    
    log_debug "Marked ${module}.${operation} as complete"
}

is_complete() {
    local module=$1
    local operation=$2
    
    init_state
    
    if command -v jq &>/dev/null; then
        local result=$(jq -r --arg mod "$module" --arg op "$operation" \
                       '.[$mod + "." + $op].completed // false' "$STATE_FILE" 2>/dev/null)
        [[ "$result" == "true" ]]
    else
        grep -q "^${module}.${operation}=" "$STATE_FILE" 2>/dev/null
    fi
}

reset_state() {
    local module=$1
    local operation=$2
    
    if [[ -z "$module" ]]; then
        log_warn "Resetting all state..."
        echo '{}' > "$STATE_FILE" 2>/dev/null || true
    else
        if command -v jq &>/dev/null; then
            local temp_file=$(mktemp)
            jq --arg mod "$module" --arg op "$operation" \
               'del(.[$mod + "." + $op])' \
               "$STATE_FILE" > "$temp_file" 2>/dev/null || true
            mv "$temp_file" "$STATE_FILE" 2>/dev/null || true
        else
            sed -i "/^${module}.${operation}=/d" "$STATE_FILE" 2>/dev/null || true
        fi
        log_info "Reset state for ${module}.${operation}"
    fi
}

save_config() {
    local key=$1
    local value=$2
    
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE" 2>/dev/null || true
    else
        echo "${key}=${value}" >> "$CONFIG_FILE" 2>/dev/null || true
    fi
    
    log_debug "Saved config: ${key}=${value}"
}

load_config() {
    local key=$1
    local default=$2
    
    if [[ -f "$CONFIG_FILE" ]]; then
        local value=$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
        echo "${value:-$default}"
    else
        echo "$default"
    fi
}

get_bridge_ip() {
    local bridge=$1
    local ip=$(ip a show "$bridge" 2>/dev/null | grep -i "inet " | awk '{print $2}' | cut -d'/' -f1)
    echo "$ip"
}

detect_cpu_vendor() {
    if grep -q 'GenuineIntel' /proc/cpuinfo; then
        echo "intel"
    elif grep -q 'AuthenticAMD' /proc/cpuinfo; then
        echo "amd"
    else
        echo "unknown"
    fi
}

wait_for_file() {
    local file=$1
    local timeout=${2:-60}
    local elapsed=0
    
    log_info "Waiting for file: $file (timeout: ${timeout}s)"
    
    while [[ ! -f "$file" && $elapsed -lt $timeout ]]; do
        sleep 2
        elapsed=$((elapsed + 2))
    done
    
    if [[ -f "$file" ]]; then
        log_info "File found: $file"
        return 0
    else
        log_error "Timeout waiting for file: $file"
        return 1
    fi
}

wait_for_service() {
    local service=$1
    local timeout=${2:-60}
    local elapsed=0
    
    log_info "Waiting for service: $service (timeout: ${timeout}s)"
    
    while ! systemctl is-active --quiet "$service" && [[ $elapsed -lt $timeout ]]; do
        sleep 2
        elapsed=$((elapsed + 2))
    done
    
    if systemctl is-active --quiet "$service"; then
        log_info "Service is active: $service"
        return 0
    else
        log_error "Timeout waiting for service: $service"
        return 1
    fi
}

confirm() {
    local message=$1
    local default=${2:-n}
    
    local prompt="[y/N]"
    [[ "$default" == "y" ]] && prompt="[Y/n]"
    
    echo -n -e "${COLOR_YELLOW}${message} ${prompt}: ${COLOR_RESET}"
    read -r response
    
    response=${response:-$default}
    [[ "$response" =~ ^[Yy]$ ]]
}

# =============================================================================
# DATABASE MODULE - Database configuration and setup
# =============================================================================

database_setup() {
    local cloudstack_version="${1:-4.22}"
    local db_user="${2:-cloud}"
    local db_password="${3:-cloud}"
    local db_host="${4:-localhost}"
    local root_password="${5:-}"
    local management_ip="${6:-127.0.0.1}"
    
    log_info "Setting up CloudStack database..."
    
    if is_complete "database" "setup"; then
        log_warn "Database already configured. Use --force to reconfigure."
        return 0
    fi
    
    if ! validate_package_installed "mysql-server"; then
        log_info "Installing MySQL server..."
        apt-get update -y
        apt-get install -y mysql-server || die "Failed to install MySQL server"
    fi
    
    log_info "Configuring MySQL for CloudStack..."
    
    if ! grep -q "server_id = 1" /etc/mysql/mysql.conf.d/mysqld.cnf 2>/dev/null; then
        cat >> /etc/mysql/mysql.conf.d/mysqld.cnf <<EOF

# CloudStack Configuration
server_id = 1
sql-mode="STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO,NO_ZERO_DATE,NO_ZERO_IN_DATE,NO_ENGINE_SUBSTITUTION"
innodb_rollback_on_timeout=1
innodb_lock_wait_timeout=600
max_connections=1000
log-bin=mysql-bin
binlog-format = 'ROW'
EOF
    fi
    
    log_info "Restarting MySQL service..."
    systemctl restart mysql || die "Failed to restart MySQL"
    wait_for_service "mysql" 30
    
    log_info "Initializing CloudStack databases..."
    cloudstack-setup-databases "$db_user:$db_password@$db_host" \
        --deploy-as=root:$root_password \
        -i "$management_ip" || die "Failed to setup CloudStack databases"
    
    save_config "CLOUDSTACK_DB_USER" "$db_user"
    save_config "CLOUDSTACK_DB_PASSWORD" "$db_password"
    save_config "MYSQL_DATABASE_HOSTNAME" "$db_host"
    save_config "CLOUDSTACK_VERSION" "$cloudstack_version"
    
    mark_complete "database" "setup"
    log_info "Database setup completed successfully"
}

database_backup() {
    local backup_dir="${1:-/var/backups/cloudstack}"
    local timestamp=$(date +%Y%m%d_%H%M%S)
    
    log_info "Backing up CloudStack databases..."
    
    mkdir -p "$backup_dir"
    
    local db_user=$(load_config "CLOUDSTACK_DB_USER" "cloud")
    local db_password=$(load_config "CLOUDSTACK_DB_PASSWORD" "cloud")
    
    mysqldump -u"$db_user" -p"$db_password" --all-databases \
        > "${backup_dir}/cloudstack_backup_${timestamp}.sql" || die "Database backup failed"
    
    log_info "Database backup saved to: ${backup_dir}/cloudstack_backup_${timestamp}.sql"
}

database_restore() {
    local backup_file="$1"
    
    if [[ ! -f "$backup_file" ]]; then
        die "Backup file not found: $backup_file"
    fi
    
    log_warn "This will restore the database from: $backup_file"
    if ! confirm "Are you sure you want to continue?"; then
        log_info "Database restore cancelled"
        return 0
    fi
    
    local db_user=$(load_config "CLOUDSTACK_DB_USER" "cloud")
    local db_password=$(load_config "CLOUDSTACK_DB_PASSWORD" "cloud")
    
    log_info "Restoring database..."
    mysql -u"$db_user" -p"$db_password" < "$backup_file" || die "Database restore failed"
    
    log_info "Database restored successfully"
}

database_status() {
    log_info "Checking database status..."
    
    if ! validate_service_running "mysql"; then
        log_error "MySQL service is not running"
        return 1
    fi
    
    log_info "MySQL service: active"
    
    local db_user=$(load_config "CLOUDSTACK_DB_USER" "cloud")
    local db_password=$(load_config "CLOUDSTACK_DB_PASSWORD" "cloud")
    
    local databases=$(mysql -u"$db_user" -p"$db_password" -e "SHOW DATABASES LIKE 'cloud%';" 2>/dev/null | tail -n +2)
    
    if [[ -n "$databases" ]]; then
        log_info "CloudStack databases found:"
        echo "$databases" | while read -r db; do
            log_info "  - $db"
        done
    else
        log_warn "No CloudStack databases found"
    fi
    
    return 0
}

# =============================================================================
# STORAGE MODULE - Storage configuration
# =============================================================================

storage_nfs_create() {
    local primary_path="${1:-/export/primary}"
    local secondary_path="${2:-/export/secondary}"
    local cks_path="${3:-/export/cks}"
    
    log_info "Setting up NFS storage..."
    
    if is_complete "storage" "nfs_create"; then
        log_warn "NFS storage already configured. Use --force to reconfigure."
        return 0
    fi
    
    if ! validate_package_installed "nfs-kernel-server"; then
        log_info "Installing NFS server packages..."
        apt-get update -y
        apt-get install -y nfs-kernel-server quota || die "Failed to install NFS server"
    fi
    
    log_info "Creating export directories..."
    mkdir -p "$primary_path" "$secondary_path" "$cks_path"
    chmod 755 "$primary_path" "$secondary_path" "$cks_path"
    
    log_info "Configuring NFS exports..."
    
    if [[ -f /etc/exports ]]; then
        cp /etc/exports /etc/exports.backup.$(date +%Y%m%d_%H%M%S) 2>/dev/null || true
    fi
    
    if ! grep -q "^/export" /etc/exports 2>/dev/null; then
        echo "/export  *(rw,async,no_root_squash,no_subtree_check)" >> /etc/exports
    fi
    
    exportfs -ra || die "Failed to apply NFS exports"
    
    log_info "Configuring NFS daemon ports..."
    
    if ! grep -q "RPCMOUNTDOPTS.*-p 892" /etc/default/nfs-kernel-server 2>/dev/null; then
        sed -i -e 's/^RPCMOUNTDOPTS="--manage-gids"$/RPCMOUNTDOPTS="-p 892 --manage-gids"/g' /etc/default/nfs-kernel-server 2>/dev/null || true
    fi
    
    if ! grep -q "STATDOPTS.*--port 662" /etc/default/nfs-common 2>/dev/null; then
        sed -i -e 's/^STATDOPTS=$/STATDOPTS="--port 662 --outgoing-port 2020"/g' /etc/default/nfs-common 2>/dev/null || true
    fi
    
    if ! grep -q "NEED_STATD=yes" /etc/default/nfs-common 2>/dev/null; then
        echo "NEED_STATD=yes" >> /etc/default/nfs-common
    fi
    
    if ! grep -q "RPCRQUOTADOPTS.*-p 875" /etc/default/quota 2>/dev/null; then
        sed -i -e 's/^RPCRQUOTADOPTS=$/RPCRQUOTADOPTS="-p 875"/g' /etc/default/quota 2>/dev/null || true
    fi
    
    log_info "Restarting NFS server..."
    systemctl restart nfs-kernel-server || die "Failed to restart NFS server"
    wait_for_service "nfs-kernel-server" 30
    
    save_config "NFS_PRIMARY_PATH" "$primary_path"
    save_config "NFS_SECONDARY_PATH" "$secondary_path"
    save_config "NFS_CKS_PATH" "$cks_path"
    
    mark_complete "storage" "nfs_create"
    log_info "NFS storage setup completed successfully"
    log_info "Primary storage: $primary_path"
    log_info "Secondary storage: $secondary_path"
    log_info "CKS storage: $cks_path"
}

storage_nfs_status() {
    log_info "NFS server status:"
    
    if ! validate_service_running "nfs-kernel-server"; then
        log_error "NFS server is not running"
        return 1
    fi
    
    log_info "NFS service: active"
    
    log_info "Active exports:"
    exportfs -v 2>/dev/null || true
    
    return 0
}

storage_nfs_remove() {
    log_warn "This will remove NFS storage configuration"
    
    if ! confirm "Are you sure you want to continue?"; then
        log_info "NFS removal cancelled"
        return 0
    fi
    
    log_info "Removing NFS exports..."
    
    if grep -q "^/export" /etc/exports 2>/dev/null; then
        sed -i '/^\/export/d' /etc/exports
        exportfs -ra 2>/dev/null || true
    fi
    
    log_info "Stopping NFS server..."
    systemctl stop nfs-kernel-server 2>/dev/null || true
    
    reset_state "storage" "nfs_create"
    log_info "NFS storage removed"
}

storage_nfs_mount() {
    local nfs_server="$1"
    local remote_path="$2"
    local local_path="$3"
    
    if [[ -z "$nfs_server" || -z "$remote_path" || -z "$local_path" ]]; then
        die "Usage: storage_nfs_mount <nfs_server> <remote_path> <local_path>"
    fi
    
    log_info "Mounting NFS share from $nfs_server:$remote_path to $local_path..."
    
    if ! validate_package_installed "nfs-common"; then
        log_info "Installing NFS client..."
        apt-get update -y
        apt-get install -y nfs-common || die "Failed to install NFS client"
    fi
    
    mkdir -p "$local_path"
    
    mount -t nfs "$nfs_server:$remote_path" "$local_path" || die "Failed to mount NFS share"
    
    local fstab_entry="$nfs_server:$remote_path $local_path nfs defaults 0 0"
    if ! grep -q "$fstab_entry" /etc/fstab 2>/dev/null; then
        echo "$fstab_entry" >> /etc/fstab
        log_info "Added to /etc/fstab for persistence"
    fi
    
    log_info "NFS share mounted successfully"
}

# =============================================================================
# MANAGEMENT MODULE - Management server operations
# =============================================================================

management_install_dependencies() {
    log_info "Installing system dependencies..."
    
    if is_complete "management" "dependencies"; then
        log_info "Dependencies already installed"
        return 0
    fi
    
    log_info "Updating system packages..."
    apt-get update -y
    apt-get full-upgrade -y
    
    log_info "Installing base packages..."
    apt-get install -y \
        openntpd \
        openssh-server \
        sudo \
        vim \
        htop \
        tar \
        bridge-utils \
        ovmf \
        uuid \
        cloud-init \
        wget \
        cloud-initramfs-growroot \
        python3 \
        jq || die "Failed to install base packages"
    
    local cpu_vendor=$(detect_cpu_vendor)
    case $cpu_vendor in
        intel)
            log_info "Installing Intel microcode..."
            apt-get install -y intel-microcode
            ;;
        amd)
            log_info "Installing AMD microcode..."
            apt-get install -y amd64-microcode mesa-utils
            ;;
        *)
            log_warn "Unknown CPU vendor, skipping microcode installation"
            ;;
    esac
    
    mark_complete "management" "dependencies"
    log_info "Dependencies installed successfully"
}

management_configure_repository() {
    local cloudstack_version="${1:-4.22}"
    
    log_info "Configuring CloudStack APT repository (version: $cloudstack_version)..."
    
    if is_complete "management" "repository"; then
        log_info "Repository already configured"
        return 0
    fi
    
    mkdir -p /etc/apt/keyrings
    
    log_info "Downloading CloudStack GPG key..."
    wget -qO - http://download.cloudstack.org/release.asc | \
        gpg --dearmor | \
        tee /etc/apt/keyrings/cloudstack.gpg >/dev/null || die "Failed to download GPG key"
    
    log_info "Adding CloudStack repository..."
    echo "deb [signed-by=/etc/apt/keyrings/cloudstack.gpg] http://download.cloudstack.org/ubuntu noble $cloudstack_version" \
        > /etc/apt/sources.list.d/cloudstack.list
    
    apt-get update -y || die "Failed to update package lists"
    
    save_config "CLOUDSTACK_VERSION" "$cloudstack_version"
    mark_complete "management" "repository"
    log_info "Repository configured successfully"
}

management_install_packages() {
    log_info "Installing CloudStack management packages..."
    
    if is_complete "management" "packages"; then
        log_info "Management packages already installed"
        return 0
    fi
    
    apt-get update -y
    apt-get install -y cloudstack-management cloudstack-usage || die "Failed to install CloudStack packages"
    
    mark_complete "management" "packages"
    log_info "Management packages installed successfully"
}

management_setup() {
    local cloudstack_version="${1:-4.22}"
    local db_user="${2:-cloud}"
    local db_password="${3:-cloud}"
    local db_host="${4:-localhost}"
    local root_password="${5:-}"
    local bridge="${6:-cloudbr0}"
    
    log_info "Starting CloudStack management server setup..."
    
    require_root
    check_prerequisites
    
    if ! validate_bridge_exists "$bridge"; then
        die "Bridge interface '$bridge' does not exist. Please create it first."
    fi
    
    local management_ip=$(get_bridge_ip "$bridge")
    if [[ -z "$management_ip" ]]; then
        die "Unable to get IP address for bridge: $bridge"
    fi
    
    log_info "Management server IP: $management_ip"
    save_config "MANAGEMENT_IP" "$management_ip"
    save_config "MANAGEMENT_BRIDGE" "$bridge"
    
    management_install_dependencies
    management_configure_repository "$cloudstack_version"
    management_install_packages
    database_setup "$cloudstack_version" "$db_user" "$db_password" "$db_host" "$root_password" "$management_ip"
    management_start
    management_configure_ssh
    management_start_key_server
    
    log_info "CloudStack management server setup completed!"
    log_info "Management UI: http://${management_ip}:8080/client"
    log_info "Default credentials: admin/password"
    log_info "SSH key server: http://${management_ip}:${SSH_KEY_SERVER_PORT}/id_rsa.pub"
}

management_start() {
    log_info "Starting CloudStack management server..."
    
    if is_complete "management" "started"; then
        if validate_service_running "cloudstack-management"; then
            log_info "Management server already running"
            return 0
        fi
    fi
    
    cloudstack-setup-management || die "Failed to setup management server"
    wait_for_service "cloudstack-management" 60
    
    mark_complete "management" "started"
    log_info "Management server started successfully"
}

management_stop() {
    log_info "Stopping CloudStack management server..."
    systemctl stop cloudstack-management cloudstack-usage 2>/dev/null || true
    log_info "Management server stopped"
}

management_restart() {
    log_info "Restarting CloudStack management server..."
    systemctl restart cloudstack-management cloudstack-usage
    wait_for_service "cloudstack-management" 60
    log_info "Management server restarted"
}

management_status() {
    log_info "CloudStack management server status:"
    
    systemctl status cloudstack-management --no-pager 2>/dev/null || true
    
    if validate_service_running "cloudstack-management"; then
        log_info "Management server is running"
        
        local management_ip=$(load_config "MANAGEMENT_IP" "localhost")
        log_info "Management UI: http://${management_ip}:8080/client"
        
        if pgrep -f "python3.*http.server.*${SSH_KEY_SERVER_PORT}" >/dev/null; then
            log_info "SSH key server: http://${management_ip}:${SSH_KEY_SERVER_PORT}/id_rsa.pub"
        fi
    else
        log_error "Management server is not running"
        return 1
    fi
}

management_configure_ssh() {
    log_info "Configuring SSH keys..."
    
    if is_complete "management" "ssh_configured"; then
        log_info "SSH keys already configured"
        return 0
    fi
    
    log_info "Waiting for SSH keys to be generated..."
    if ! wait_for_file "${SSH_KEY_DIR}/id_rsa.pub" 120; then
        die "SSH keys were not generated"
    fi
    
    log_info "Configuring root SSH access..."
    mkdir -p /root/.ssh
    
    if [[ -f /root/.ssh/authorized_keys ]]; then
        log_info "Cleaning root blocker commands in authorized_keys..."
        sed '1s/.*exit 142" //' /root/.ssh/authorized_keys > /root/.ssh/authorized_keys.tmp 2>/dev/null || true
        mv /root/.ssh/authorized_keys.tmp /root/.ssh/authorized_keys 2>/dev/null || true
    fi
    
    cat "${SSH_KEY_DIR}/id_rsa.pub" >> /root/.ssh/authorized_keys
    chmod 600 /root/.ssh/authorized_keys
    
    mark_complete "management" "ssh_configured"
    log_info "SSH keys configured successfully"
}

management_start_key_server() {
    log_info "Starting SSH key HTTP server..."
    
    if [[ ! -f "${SSH_KEY_DIR}/id_rsa.pub" ]]; then
        log_warn "SSH public key not found, skipping HTTP server setup"
        return 0
    fi
    
    if pgrep -f "python3.*http.server.*${SSH_KEY_SERVER_PORT}" >/dev/null; then
        log_info "SSH key HTTP server already running"
        return 0
    fi
    
    log_info "Creating systemd service for SSH key server..."
    cat > /etc/systemd/system/cloudstack-keyserver.service <<EOF
[Unit]
Description=CloudStack SSH Key HTTP Server
After=cloudstack-management.service
Requires=cloudstack-management.service

[Service]
Type=simple
WorkingDirectory=${SSH_KEY_DIR}
ExecStart=/usr/bin/python3 -m http.server ${SSH_KEY_SERVER_PORT}
Restart=on-failure
User=cloud
Group=cloud

[Install]
WantedBy=multi-user.target
EOF
    
    systemctl daemon-reload
    systemctl enable cloudstack-keyserver.service 2>/dev/null || true
    systemctl start cloudstack-keyserver.service 2>/dev/null || true
    
    sleep 2
    
    if systemctl is-active --quiet cloudstack-keyserver.service; then
        local management_ip=$(load_config "MANAGEMENT_IP" "localhost")
        log_info "SSH key HTTP server started: http://${management_ip}:${SSH_KEY_SERVER_PORT}/id_rsa.pub"
    else
        log_warn "Failed to start SSH key HTTP server"
    fi
}

management_stop_key_server() {
    log_info "Stopping SSH key HTTP server..."
    systemctl stop cloudstack-keyserver.service 2>/dev/null || true
    systemctl disable cloudstack-keyserver.service 2>/dev/null || true
    log_info "SSH key HTTP server stopped"
}

# =============================================================================
# WORKER MODULE - KVM host/worker configuration
# =============================================================================

worker_configure() {
    local management_server_url="${1:-}"
    local bridge="${2:-cloudbr0}"
    
    log_info "Configuring CloudStack KVM host..."
    
    require_root
    
    if ! validate_bridge_exists "$bridge"; then
        die "Bridge interface '$bridge' does not exist. Please create it first."
    fi
    
    if is_complete "worker" "configured"; then
        log_warn "Worker already configured. Use --force to reconfigure."
        return 0
    fi
    
    worker_install_packages
    worker_configure_libvirt
    worker_configure_network
    worker_configure_uefi
    worker_configure_firewall
    worker_disable_apparmor
    
    if [[ -n "$management_server_url" ]]; then
        worker_fetch_ssh_key "$management_server_url"
    fi
    
    systemctl restart libvirtd 2>/dev/null || true
    systemctl restart cloudstack-agent 2>/dev/null || true
    
    mark_complete "worker" "configured"
    log_info "KVM host configured successfully"
    log_info "Note: After adding this host to CloudStack, run: cloudstack.sh worker post-setup"
}

worker_install_packages() {
    log_info "Installing KVM and CloudStack agent packages..."
    
    if is_complete "worker" "packages"; then
        log_info "Packages already installed"
        return 0
    fi
    
    apt-get update -y
    apt-get install -y qemu-kvm cloudstack-agent || die "Failed to install KVM packages"
    
    mark_complete "worker" "packages"
    log_info "KVM packages installed successfully"
}

worker_configure_libvirt() {
    log_info "Configuring libvirt..."
    
    if ! grep -q 'vnc_listen = "0.0.0.0"' /etc/libvirt/qemu.conf 2>/dev/null; then
        sed -i -e 's/#vnc_listen.*$/vnc_listen = "0.0.0.0"/g' /etc/libvirt/qemu.conf 2>/dev/null || true
    fi
    
    systemctl mask libvirtd.socket libvirtd-ro.socket libvirtd-admin.socket \
                     libvirtd-tls.socket libvirtd-tcp.socket 2>/dev/null || true
    
    if ! grep -q 'remote_mode="legacy"' /etc/libvirt/libvirt.conf 2>/dev/null; then
        echo 'remote_mode="legacy"' >> /etc/libvirt/libvirt.conf
    fi
    
    local libvirtd_conf="/etc/libvirt/libvirtd.conf"
    
    if ! grep -q 'listen_tls=0' "$libvirtd_conf" 2>/dev/null; then
        echo 'listen_tls=0' >> "$libvirtd_conf"
    fi
    
    if ! grep -q 'listen_tcp=1' "$libvirtd_conf" 2>/dev/null; then
        echo 'listen_tcp=1' >> "$libvirtd_conf"
    fi
    
    if ! grep -q 'tcp_port = "16509"' "$libvirtd_conf" 2>/dev/null; then
        echo 'tcp_port = "16509"' >> "$libvirtd_conf"
    fi
    
    if ! grep -q 'mdns_adv = 0' "$libvirtd_conf" 2>/dev/null; then
        echo 'mdns_adv = 0' >> "$libvirtd_conf"
    fi
    
    if ! grep -q 'auth_tcp = "none"' "$libvirtd_conf" 2>/dev/null; then
        echo 'auth_tcp = "none"' >> "$libvirtd_conf"
    fi
    
    if ! grep -q 'host_uuid' "$libvirtd_conf" 2>/dev/null; then
        local host_uuid=$(uuid)
        echo "host_uuid = \"$host_uuid\"" >> "$libvirtd_conf"
        log_info "Generated host UUID: $host_uuid"
        save_config "HOST_UUID" "$host_uuid"
    fi
    
    log_info "Libvirt configured successfully"
}

worker_configure_network() {
    log_info "Configuring network settings..."
    
    if ! grep -q "net.bridge.bridge-nf-call-arptables = 0" /etc/sysctl.conf 2>/dev/null; then
        echo "net.bridge.bridge-nf-call-arptables = 0" >> /etc/sysctl.conf
        echo "net.bridge.bridge-nf-call-iptables = 0" >> /etc/sysctl.conf
        echo "net.bridge.bridge-nf-call-ip6tables = 0" >> /etc/sysctl.conf
        sysctl -p 2>/dev/null || true
    fi
    
    log_info "Network settings configured"
}

worker_configure_uefi() {
    log_info "Configuring UEFI support..."
    
    local uefi_config="/etc/cloudstack/agent/uefi.properties"
    
    if [[ -f "$uefi_config" ]] && grep -q "guest.nvram.template.secure" "$uefi_config" 2>/dev/null; then
        log_info "UEFI already configured"
        return 0
    fi
    
    mkdir -p /etc/cloudstack/agent
    
    cat > "$uefi_config" <<EOF
guest.nvram.template.secure=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
guest.nvram.template.legacy=/usr/share/OVMF/OVMF_4M.fd
guest.nvram.path=/var/lib/libvirt/qemu/nvram/
guest.loader.secure=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
guest.loader.legacy=/usr/share/OVMF/OVMF_CODE_4M.fd
EOF
    
    log_info "UEFI support configured"
}

worker_configure_firewall() {
    log_info "Configuring firewall..."
    
    if ufw status 2>/dev/null | grep -q inactive; then
        log_info "UFW is inactive, skipping firewall configuration"
        return 0
    fi
    
    log_info "Adding firewall rules..."
    ufw allow mysql 2>/dev/null || true
    ufw allow proto tcp from any to any port 22 2>/dev/null || true
    ufw allow proto tcp from any to any port 1798 2>/dev/null || true
    ufw allow proto tcp from any to any port 16509 2>/dev/null || true
    ufw allow proto tcp from any to any port 16514 2>/dev/null || true
    ufw allow proto tcp from any to any port 5900:6100 2>/dev/null || true
    ufw allow proto tcp from any to any port 49152:49216 2>/dev/null || true
    
    log_info "Firewall configured"
}

worker_disable_apparmor() {
    log_info "Disabling AppArmor for libvirtd..."
    
    if [[ ! -d /etc/apparmor.d/disable ]]; then
        mkdir -p /etc/apparmor.d/disable
    fi
    
    if [[ -f /etc/apparmor.d/usr.sbin.libvirtd ]]; then
        ln -sf /etc/apparmor.d/usr.sbin.libvirtd /etc/apparmor.d/disable/ 2>/dev/null || true
        apparmor_parser -R /etc/apparmor.d/usr.sbin.libvirtd 2>/dev/null || true
    fi
    
    if [[ -f /etc/apparmor.d/usr.lib.libvirt.virt-aa-helper ]]; then
        ln -sf /etc/apparmor.d/usr.lib.libvirt.virt-aa-helper /etc/apparmor.d/disable/ 2>/dev/null || true
        apparmor_parser -R /etc/apparmor.d/usr.lib.libvirt.virt-aa-helper 2>/dev/null || true
    fi
    
    log_info "AppArmor disabled for libvirtd"
}

worker_fetch_ssh_key() {
    local management_server_url="$1"
    
    log_info "Fetching SSH key from management server..."
    
    local base_url="${management_server_url%/id_rsa.pub}"
    local key_url="${base_url}/id_rsa.pub"
    
    local temp_key=$(mktemp)
    if wget -q -O "$temp_key" "$key_url" 2>/dev/null; then
        mkdir -p /root/.ssh
        cat "$temp_key" >> /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
        rm -f "$temp_key"
        log_info "SSH key added to root authorized_keys"
    else
        log_warn "Failed to fetch SSH key from: $key_url"
        log_info "You may need to manually add the management server's SSH key"
    fi
}

worker_post_setup() {
    log_info "Running post-setup configuration..."
    
    if is_complete "worker" "post_setup"; then
        log_warn "Post-setup already completed"
        return 0
    fi
    
    log_info "Unmasking libvirtd sockets..."
    systemctl unmask libvirtd.socket libvirtd-ro.socket libvirtd-admin.socket \
                      libvirtd-tls.socket libvirtd-tcp.socket 2>/dev/null || true
    
    log_info "Reconfiguring libvirtd..."
    systemctl stop libvirtd 2>/dev/null || true
    systemctl start libvirtd-tls.socket 2>/dev/null || true
    systemctl enable libvirtd-tls.socket 2>/dev/null || true
    systemctl restart cloudstack-agent 2>/dev/null || true
    
    mark_complete "worker" "post_setup"
    log_info "Post-setup completed successfully"
    log_warn "A reboot is recommended to ensure all changes take effect"
    
    if confirm "Would you like to reboot now?"; then
        log_info "Rebooting system..."
        reboot
    fi
}

worker_status() {
    log_info "CloudStack KVM host status:"
    
    if validate_service_running "libvirtd"; then
        log_info "libvirtd: active"
    else
        log_error "libvirtd: inactive"
    fi
    
    if validate_service_running "cloudstack-agent"; then
        log_info "cloudstack-agent: active"
    else
        log_error "cloudstack-agent: inactive"
    fi
    
    local host_uuid=$(grep 'host_uuid' /etc/libvirt/libvirtd.conf 2>/dev/null | cut -d'"' -f2)
    if [[ -n "$host_uuid" ]]; then
        log_info "Host UUID: $host_uuid"
    fi
    
    local vm_count=$(virsh list --all 2>/dev/null | tail -n +3 | wc -l)
    log_info "Total VMs: $vm_count"
    
    return 0
}

# =============================================================================
# CLI INTERFACE - Command parsing and routing
# =============================================================================

show_usage() {
    cat <<EOF
CloudStack CLI v${VERSION}

Usage: $(basename "$0") <component> <action> [options]

Components and Actions:

  management
    setup               Setup management server
    start               Start management server
    stop                Stop management server
    restart             Restart management server
    status              Show management server status
    
  storage
    nfs create          Create NFS storage
    nfs status          Show NFS status
    nfs remove          Remove NFS storage
    nfs mount           Mount NFS share
    
  worker
    configure           Configure KVM host
    post-setup          Post-setup after adding to CloudStack
    status              Show worker status
    
  database
    backup              Backup database
    restore             Restore database
    status              Show database status
    
  all-in-one
    setup               Complete single-node setup
    
  system
    status              Show overall system status
    reset               Reset state tracking
    
Global Options:
  -h, --help           Show this help message
  -v, --verbose        Enable verbose output
  -d, --debug          Enable debug output
  -f, --force          Force operation (skip checks)
  --version            Show version

Management Setup Options:
  --cloudstack-version VERSION    CloudStack version (default: 4.22)
  --cloud-db-user USER           Database user (default: cloud)
  --cloud-db-password PASS       Database password (default: cloud)
  --mysql-db-host HOST           MySQL host (default: localhost)
  --mysql-root-password PASS     MySQL root password (default: empty)
  --bridge BRIDGE                Bridge interface (default: cloudbr0)

Storage NFS Options:
  --primary-path PATH            Primary storage path (default: /export/primary)
  --secondary-path PATH          Secondary storage path (default: /export/secondary)
  --cks-path PATH                CKS storage path (default: /export/cks)

Worker Configure Options:
  --management-server URL        Management server URL for SSH key
  --bridge BRIDGE                Bridge interface (default: cloudbr0)

Examples:

  # Complete single-node setup
  $(basename "$0") all-in-one setup --cloudstack-version 4.22 --bridge cloudbr0

  # Setup management server
  $(basename "$0") management setup --cloudstack-version 4.22 --bridge cloudbr0

  # Create NFS storage
  $(basename "$0") storage nfs create

  # Configure worker node
  $(basename "$0") worker configure --management-server http://192.168.1.10:8000

  # Check system status
  $(basename "$0") system status

Download: curl -O https://raw.githubusercontent.com/nulcell/homecloud/main/cloudstack/setup/cloudstack
EOF
}

parse_global_options() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_usage
                exit 0
                ;;
            -v|--verbose)
                LOG_LEVEL=$LOG_LEVEL_INFO
                shift
                ;;
            -d|--debug)
                LOG_LEVEL=$LOG_LEVEL_DEBUG
                set -x
                shift
                ;;
            -f|--force)
                FORCE_MODE=true
                shift
                ;;
            --version)
                echo "CloudStack CLI v${VERSION}"
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done
}

handle_management() {
    local action=$1
    shift
    
    local cloudstack_version="4.22"
    local db_user="cloud"
    local db_password="cloud"
    local db_host="localhost"
    local root_password=""
    local bridge="cloudbr0"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --cloudstack-version) cloudstack_version="$2"; shift 2 ;;
            --cloud-db-user) db_user="$2"; shift 2 ;;
            --cloud-db-password) db_password="$2"; shift 2 ;;
            --mysql-db-host) db_host="$2"; shift 2 ;;
            --mysql-root-password) root_password="$2"; shift 2 ;;
            --bridge) bridge="$2"; shift 2 ;;
            *) log_error "Unknown option: $1"; exit 1 ;;
        esac
    done
    
    case $action in
        setup) management_setup "$cloudstack_version" "$db_user" "$db_password" "$db_host" "$root_password" "$bridge" ;;
        start) management_start ;;
        stop) management_stop ;;
        restart) management_restart ;;
        status) management_status ;;
        *) log_error "Unknown management action: $action"; exit 1 ;;
    esac
}

handle_storage() {
    local subcomponent=$1
    local action=$2
    shift 2
    
    case $subcomponent in
        nfs)
            local primary_path="/export/primary"
            local secondary_path="/export/secondary"
            local cks_path="/export/cks"
            local nfs_server=""
            local remote_path=""
            local local_path=""
            
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --primary-path) primary_path="$2"; shift 2 ;;
                    --secondary-path) secondary_path="$2"; shift 2 ;;
                    --cks-path) cks_path="$2"; shift 2 ;;
                    --nfs-server) nfs_server="$2"; shift 2 ;;
                    --remote-path) remote_path="$2"; shift 2 ;;
                    --local-path) local_path="$2"; shift 2 ;;
                    *) log_error "Unknown option: $1"; exit 1 ;;
                esac
            done
            
            case $action in
                create) storage_nfs_create "$primary_path" "$secondary_path" "$cks_path" ;;
                status) storage_nfs_status ;;
                remove) storage_nfs_remove ;;
                mount) storage_nfs_mount "$nfs_server" "$remote_path" "$local_path" ;;
                *) log_error "Unknown NFS action: $action"; exit 1 ;;
            esac
            ;;
        *) log_error "Unknown storage subcomponent: $subcomponent"; exit 1 ;;
    esac
}

handle_worker() {
    local action=$1
    shift
    
    local management_server=""
    local bridge="cloudbr0"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --management-server) management_server="$2"; shift 2 ;;
            --bridge) bridge="$2"; shift 2 ;;
            *) log_error "Unknown option: $1"; exit 1 ;;
        esac
    done
    
    case $action in
        configure) worker_configure "$management_server" "$bridge" ;;
        post-setup) worker_post_setup ;;
        status) worker_status ;;
        *) log_error "Unknown worker action: $action"; exit 1 ;;
    esac
}

handle_database() {
    local action=$1
    shift
    
    local backup_dir="/var/backups/cloudstack"
    local backup_file=""
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --backup-dir) backup_dir="$2"; shift 2 ;;
            --backup-file) backup_file="$2"; shift 2 ;;
            *) log_error "Unknown option: $1"; exit 1 ;;
        esac
    done
    
    case $action in
        backup) database_backup "$backup_dir" ;;
        restore)
            if [[ -z "$backup_file" ]]; then
                log_error "Backup file required. Use --backup-file FILE"
                exit 1
            fi
            database_restore "$backup_file"
            ;;
        status) database_status ;;
        *) log_error "Unknown database action: $action"; exit 1 ;;
    esac
}

handle_all_in_one() {
    local action=$1
    shift
    
    local cloudstack_version="4.22"
    local db_user="cloud"
    local db_password="cloud"
    local db_host="localhost"
    local root_password=""
    local bridge="cloudbr0"
    local primary_path="/export/primary"
    local secondary_path="/export/secondary"
    local cks_path="/export/cks"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --cloudstack-version) cloudstack_version="$2"; shift 2 ;;
            --cloud-db-user) db_user="$2"; shift 2 ;;
            --cloud-db-password) db_password="$2"; shift 2 ;;
            --mysql-db-host) db_host="$2"; shift 2 ;;
            --mysql-root-password) root_password="$2"; shift 2 ;;
            --bridge) bridge="$2"; shift 2 ;;
            --primary-path) primary_path="$2"; shift 2 ;;
            --secondary-path) secondary_path="$2"; shift 2 ;;
            --cks-path) cks_path="$2"; shift 2 ;;
            *) log_error "Unknown option: $1"; exit 1 ;;
        esac
    done
    
    case $action in
        setup)
            log_info "Starting all-in-one CloudStack setup..."
            
            management_setup "$cloudstack_version" "$db_user" "$db_password" "$db_host" "$root_password" "$bridge"
            storage_nfs_create "$primary_path" "$secondary_path" "$cks_path"
            worker_configure "" "$bridge"
            
            local management_ip=$(load_config "MANAGEMENT_IP" "localhost")
            
            log_info ""
            log_info "================================================================"
            log_info "All-in-one CloudStack setup completed!"
            log_info "================================================================"
            log_info ""
            log_info "Access Information:"
            log_info "  Management UI: http://${management_ip}:8080/client"
            log_info "  Default credentials: admin/password"
            log_info "  SSH key server: http://${management_ip}:8000/id_rsa.pub"
            log_info ""
            log_info "Storage Paths:"
            log_info "  Primary: $primary_path"
            log_info "  Secondary: $secondary_path"
            log_info "  CKS: $cks_path"
            log_info ""
            log_info "Next Steps:"
            log_info "  1. Access the Management UI and change admin password"
            log_info "  2. Create Zone, Pod, and Cluster"
            log_info "  3. Add this host: $(hostname -f)"
            log_info "  4. Configure Primary and Secondary Storage"
            log_info "  5. Run: $(basename "$0") worker post-setup"
            log_info "  6. Reboot the system"
            ;;
        *) log_error "Unknown all-in-one action: $action"; exit 1 ;;
    esac
}

handle_system() {
    local action=$1
    shift
    
    case $action in
        status)
            log_info "CloudStack System Status"
            log_info "========================"
            echo ""
            
            if is_complete "management" "started"; then
                management_status
            else
                log_info "Management server: not configured"
            fi
            
            echo ""
            
            if is_complete "storage" "nfs_create"; then
                storage_nfs_status
            else
                log_info "NFS storage: not configured"
            fi
            
            echo ""
            
            if is_complete "worker" "configured"; then
                worker_status
            else
                log_info "Worker: not configured"
            fi
            
            echo ""
            
            if is_complete "database" "setup"; then
                database_status
            else
                log_info "Database: not configured"
            fi
            ;;
        reset)
            log_warn "This will reset all state tracking"
            if confirm "Are you sure?"; then
                reset_state
                log_info "State reset complete"
            fi
            ;;
        *) log_error "Unknown system action: $action"; exit 1 ;;
    esac
}

main() {
    parse_global_options "$@"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help|-v|--verbose|-d|--debug|-f|--force|--version) shift ;;
            *) break ;;
        esac
    done
    
    local component=$1
    if [[ "$component" != "system" && "$component" != "--help" && "$component" != "-h" ]]; then
        require_root
    fi
    
    if [[ $# -lt 1 ]]; then
        show_usage
        exit 1
    fi
    
    component=$1
    shift
    
    case $component in
        management)
            [[ $# -lt 1 ]] && { log_error "Action required for management component"; exit 1; }
            handle_management "$@"
            ;;
        storage)
            [[ $# -lt 2 ]] && { log_error "Subcomponent and action required for storage"; exit 1; }
            handle_storage "$@"
            ;;
        worker)
            [[ $# -lt 1 ]] && { log_error "Action required for worker component"; exit 1; }
            handle_worker "$@"
            ;;
        database)
            [[ $# -lt 1 ]] && { log_error "Action required for database component"; exit 1; }
            handle_database "$@"
            ;;
        all-in-one)
            [[ $# -lt 1 ]] && { log_error "Action required for all-in-one"; exit 1; }
            handle_all_in_one "$@"
            ;;
        system)
            [[ $# -lt 1 ]] && { log_error "Action required for system"; exit 1; }
            handle_system "$@"
            ;;
        *)
            log_error "Unknown component: $component"
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
